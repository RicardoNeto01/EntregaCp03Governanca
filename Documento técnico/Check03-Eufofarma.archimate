  <folder name="Motivation" id="id-47f127fd07ee454aa94b8efb22c82d86" type="motivation">
    <element xsi:type="archimate:Stakeholder" name="Equipe de inovação EuroFarma" id="id-01aa07e606f74a33957c128119e78ca2"/>
    <element xsi:type="archimate:Driver" name="Registrar novas ideias dos colaboradores" id="id-a2f2f473950f4ad28dcc55b2e5f5f35f"/>
    <element xsi:type="archimate:Driver" name="Aumentar a colaboração dos funcionários nos projetos da empresa" id="id-13a52e2050bc4bfe8b006a04b93462d3"/>
    <element xsi:type="archimate:Driver" name="Centralizar as ideias dos departamentos de inovação" id="id-78fc626835d345a29240261e7a604b93"/>
    <element xsi:type="archimate:Driver" name="Driver" id="id-177765e993904d6a848a3c700c04843c"/>
    <element xsi:type="archimate:Driver" name="Gerenciar sugestões de inovação dos colaboradores de diversas áreas" id="id-cff0ad91b02e4eb2b6498ebbc8842488"/>
    <element xsi:type="archimate:Driver" name="Centralizar projetos das equipes de inovação" id="id-28fa57b7f78a43b083502d05b6317cc7"/>
    <element xsi:type="archimate:Goal" name="Aumentar a quantidade de oportunidades de inovação da empresa" id="id-7286ff9660994deda75522c745740494"/>
    <element xsi:type="archimate:Goal" name="Melhorar a satisfação com os processos da empresa." id="id-fd00f7a34178472aa399e293e8040905"/>
    <element xsi:type="archimate:Goal" id="id-3bfa8b164c414c5ca28a9cbb7efe5494"/>
    <element xsi:type="archimate:Driver" name="Aumentar satisfação dos colaboradores da empresa." id="id-f8e27c1183a846e1bb4b77c08e880cc2"/>
    <element xsi:type="archimate:Goal" name="Bonificar o colaborador de acordo os projetos implementados" id="id-c1c88c0894844f9cbaec6e90cc43ceb6"/>
    <element xsi:type="archimate:Goal" name="Dar transparência de quais projetos foram avaliados para desenvolvimento" id="id-69252c02434545e1b9c4bae18cf6c351"/>
    <element xsi:type="archimate:Goal" name="Fazer com que os projetos de diferentes equipes se conversem" id="id-f899c3f4f19e42cdb2f0e4a176add15e"/>
    <element xsi:type="archimate:Outcome" name="Fazer com que as equipes possam ver 100% dos projetos uma das outras" id="id-6c93ece99cb84bd98d6d7832b8be7a42"/>
    <element xsi:type="archimate:Outcome" name="Escolher 20% dos projetos do ano a partir dos projetos dos colaboradores" id="id-681d7d7daf334f83aadb1111fd580ca3"/>
    <element xsi:type="archimate:Outcome" name="Mostrar 100% dos projetos enviados e avaliados no site" id="id-5cb322106b704060b1c1fb1febc5ebc3"/>
    <element xsi:type="archimate:Outcome" id="id-f9db984af7824f6890886873f68600e7"/>
    <element xsi:type="archimate:Outcome" id="id-8fd83de3f0e947be86621f5781e806c9"/>
    <element xsi:type="archimate:Assessment" name="Relatório gerado pelo marketing para medir a satisfação com o sistema" id="id-c81c632709bd475590e2f00d165cf23c"/>
    <element xsi:type="archimate:Assessment" id="id-56b3347b25a4490298e629235fecf811"/>
    <element xsi:type="archimate:Stakeholder" name="Equipe de inovação EuroFarma" id="id-246298c5539e4b068fd01c7ffe2b703a"/>
    <element xsi:type="archimate:Stakeholder" name="              Colaboradores" id="id-79ab4055a9a04a64a94e640e2e87bb1c"/>
    <element xsi:type="archimate:Driver" name="Driver" id="id-21f95c40e9e44a11ab00817867a9884a">
      <documentation>ss</documentation>
    </element>
    <element xsi:type="archimate:Driver" name="Aumentar o número de ideias vindas dos colaboradores" id="id-d9bba48735dd4493983fadb2e078834e"/>
    <element xsi:type="archimate:Driver" name="Reduzir reclamações dos colaboradores com os processos da empresa" id="id-99d5689f19444c2796c9daea697f7e3c"/>
    <element xsi:type="archimate:Driver" name="Engajar e convencer colaboradores de que eles também podem inovar" id="id-d59f264436614e96977f031c81095d63"/>
    <element xsi:type="archimate:Goal" name="Promover um ambiente de trabalho alinhado com as expectativas do colaborador" id="id-6e358b96c4b443b296c77e9665b8a880"/>
    <element xsi:type="archimate:Goal" name="Dar transparência de quais ideias são selecionadas e avaliadas" id="id-27cef20781044534a235a8c514dd5fe7"/>
    <element xsi:type="archimate:Goal" name="Recompensar as melhores ideias e acompanhar o feedback após implementação" id="id-7b46f02dc71c4a9dbc04c83470680cc3"/>
    <element xsi:type="archimate:Driver" name="Aproximar as equipes de inovação" id="id-af6bdf6118414effa6546563b02bc2a3"/>
    <element xsi:type="archimate:Goal" name="Centralizar as ideias desenvolvidas em um único lugar" id="id-532780a097914aa49e25fc8e6c5f9e64"/>
    <element xsi:type="archimate:Outcome" name="100% das ideias selecionadas para desenvolvimento registradas em sistema" id="id-a13e587c7bec4727b75cda4ffeb7282b"/>
    <element xsi:type="archimate:Outcome" name="100% das ideias recebidas pelos colaboradores registradas em sistemas" id="id-63d7336d57fa4e6d84387f506a1d9e23"/>
    <element xsi:type="archimate:Outcome" name="Pelo menos 15% das ideias de projetos do ano vindos do programa de inovação de colaboradores" id="id-b53f8c6a2cb3407da425e0a8a07beeb7"/>
    <element xsi:type="archimate:Outcome" id="id-8b82dd47e07743cea13d8c61a8b75a0a"/>
    <element xsi:type="archimate:Outcome" name="Criar um ranking e recompensar os 10 primeiros colaboradores com as melhores ideias" id="id-1ac4b1e4e6f648308910c3f3c159a804"/>
    <element xsi:type="archimate:Assessment" name="Criar campanhas de engajamento para incentivar ainda mais os colaboradores a inovarem e perceberem os benefícios próprios disso" id="id-efa594c7521749f4b942eccffc309a92"/>
    <element xsi:type="archimate:Assessment" name="Desenvolver um sistema que unifique as ideias recebidas e desenvolvidas em um único lugar, onde seja possível ver progresso, comentários sobre a inovação e expectativas sobre o projeto." id="id-250dfc973ded4768875e80bacf2f80cc"/>
    <element xsi:type="archimate:Assessment" name="Gerar relatórios mensais sobre número de inovações vindas de colaboradores" id="id-f545bb1d8c944d6492851cebc8c412b7"/>
    <element xsi:type="archimate:Requirement" name="Registrar uma nova ideia" id="id-48a9d897edf44472a7c71ee479a32842"/>
    <element xsi:type="archimate:Requirement" name="Selecionar ideia para desenvolvimento" id="id-555b85a9949a42ccb991eab6dbc10ec5"/>
    <element xsi:type="archimate:Requirement" name="Comentar e avaliar dentro da ideia proposta" id="id-ea8e9b6a292f4e37b81ba2ceff798603"/>
    <element xsi:type="archimate:Requirement" name="Visualizar todas as ideias enviadas até o momento" id="id-e5e085b029454e599365edc0fff730f5"/>
    <element xsi:type="archimate:Requirement" name="Ter a opção de avaliar as ideias enviadas" id="id-98ba235b44804f0b99a51906a174316d"/>
    <element xsi:type="archimate:Requirement" name="Promover uma pesquisa de satisfação" id="id-2df12b36f40d4b859a23ae4ce785228e"/>
    <element xsi:type="archimate:Requirement" name="Relatório de melhores ideias e colaborador responsável pela ideia" id="id-706c36042c99442aaf477fcbace76625"/>
    <element xsi:type="archimate:Requirement" name="ChatBot de dúvidas do que é possivel fazer dentro de nosso sistema" id="id-d9bfce62f0d04291919e90157ed16b82"/>
    <element xsi:type="archimate:Meaning" name="Meaning" id="id-a75aa7b489804d19a3694a7f5f7069b9"/>
    <element xsi:type="archimate:Meaning" name="Meaning" id="id-4947c7606d06477fb20cc14e281e1663"/>
    <element xsi:type="archimate:Constraint" name="Cada ideia deve conter: Data e hora de registro, responsável pela ideia, possibilidade de avaliação por usuários dentro do sistema, visualização por parte do usuário se sua ideia está sendo trabalhada ou não, qual problema visa melhorar/resolver " id="id-f91dfc108f964e6baab32219f899a0d4"/>
    <element xsi:type="archimate:Constraint" name="Listar todas as ideias enviadas até o momento" id="id-ab1c255b7d1d41438c9e73183ee677d3"/>
    <element xsi:type="archimate:Constraint" name="Sistema deve conter possibilidade de avaliação de 1 até 5 estrelas e comentários sendo opcionais(resposta pode ser anonima ou não)" id="id-2730bce8f5a648af994e6099100f1afe"/>
    <element xsi:type="archimate:Constraint" name="Sistema deve conter um chatbot que auxilia os usúarios do que é possivel, e do que não é possivel fazer, sendo o primeiro suporte ao usuário de maneira rápida" id="id-a21974214f064852a180d27b71b2282b"/>
    <element xsi:type="archimate:Constraint" name="Para desenvolvimento, o sistema deve conter: Id e motivo de seleção para desenvolvimento, resultados esperados com inovação, prazo esperado, requisitos, planejamento de feedbacks e entregas" id="id-45062e1f90d34787af45300cdd6acb55"/>
    <element xsi:type="archimate:Constraint" name="Elaborar uma pesquisa semestral, com: Perguntas sobre o aplicativo, perguntas sobre melhorias do ambiente de trabalho" id="id-c44d75f5a39b4de2b17ceaa4266ae7b9"/>
    <element xsi:type="archimate:Constraint" name="Sistema deve conter uma filtragem interna com as melhores avaliações por cada ideia, registrar os comentários e os responsáveis pela avaliação para visualização de todos os usuários" id="id-5a50fcf2518345e2afaeee696e659674"/>
  </folder>
